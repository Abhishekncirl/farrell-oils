rules_version = '2';

// Firestore security rules for Farrell Oils.
//
// - Anyone can CREATE an enquiry, but only with the exact, size-limited shape
//   the website forms send (see src/lib/enquiries.js).
// - Only admins can READ, UPDATE (read/actioned flags and notes) or DELETE them.
// - Admins are the email addresses listed in isAdmin() below. Being signed in is
//   NOT enough on its own, because Firebase lets anyone create an account via its
//   public API.
//
// To add or remove an admin: edit the list, then publish the rules
// (Firebase console > Firestore > Rules, or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin emails. To add one: 'farrelloils@gmail.com', 'name@example.com'
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'farrelloils@gmail.com'
        ];
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isValidEnquiry(d) {
      let fields = ['type', 'name', 'phone', 'email', 'message', 'details',
                    'isRead', 'isActioned', 'notes', 'createdAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.type in ['quote', 'general']
        && str(d.name, 1, 200)
        && str(d.phone, 7, 40)
        && str(d.email, 0, 320)
        && str(d.message, 0, 5000)
        && d.details is map
        && d.details.keys().hasOnly(['product', 'quantity', 'address', 'eircode'])
        && d.details.size() <= 4
        && d.isRead == false
        && d.isActioned == false
        && d.notes == ''
        && d.createdAt == request.time;
    }

    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiry(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead', 'isActioned', 'notes'])
        && request.resource.data.isRead is bool
        && request.resource.data.isActioned is bool
        && str(request.resource.data.notes, 0, 2000);
    }

    // ---- Site settings ----
    // Public pages read settings/site (opening hours) and settings/contact;
    // only admins can change them.

    // Opening hours (settings/site).
    function validTime(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validDay(d) {
      return d is map
        && d.keys().hasOnly(['closed', 'opens', 'closes'])
        && d.keys().hasAll(['closed', 'opens', 'closes'])
        && d.closed is bool
        && validTime(d.opens)
        && validTime(d.closes);
    }

    function isValidSettings(d) {
      let days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
      return d.keys().hasOnly(['hours', 'updatedAt'])
        && d.hours is map
        && d.hours.keys().hasOnly(days) && d.hours.keys().hasAll(days)
        && validDay(d.hours.mon) && validDay(d.hours.tue) && validDay(d.hours.wed)
        && validDay(d.hours.thu) && validDay(d.hours.fri) && validDay(d.hours.sat)
        && validDay(d.hours.sun)
        && d.updatedAt == request.time;
    }

    // Contact details + sales reps (settings/contact).
    function isValidContact(d) {
      let fields = ['phone', 'email', 'building', 'street', 'locality', 'region',
                    'eircode', 'salesReps', 'updatedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && str(d.phone, 7, 40)
        && str(d.email, 3, 320)
        && str(d.building, 0, 100)
        && str(d.street, 0, 100)
        && str(d.locality, 1, 100)
        && str(d.region, 1, 100)
        && str(d.eircode, 0, 10)
        && d.salesReps is list && d.salesReps.size() <= 20
        && d.updatedAt == request.time;
    }

    match /settings/{docId} {
      allow read: if docId in ['site', 'contact'];
      allow create, update: if isAdmin() && (
        (docId == 'site' && isValidSettings(request.resource.data))
        || (docId == 'contact' && isValidContact(request.resource.data))
      );
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
